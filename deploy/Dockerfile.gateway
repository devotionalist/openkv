# OpenKV C++ compute gateway（gateway_node）
# 构建：docker build -f deploy/Dockerfile.gateway -t openkv-gateway:dev .

FROM ubuntu:24.04 AS build
RUN apt-get update && DEBIAN_FRONTEND=noninteractive apt-get install -y \
    build-essential cmake git pkg-config ccache \
    protobuf-compiler-grpc libgrpc++-dev libprotobuf-dev \
    && rm -rf /var/lib/apt/lists/*
WORKDIR /src
COPY . .
RUN cmake -B build \
      -DOPENKV_BUILD_TESTS=OFF \
 && cmake --build build -j"$(nproc)" --target gateway_node

FROM ubuntu:24.04
RUN apt-get update && DEBIAN_FRONTEND=noninteractive apt-get install -y --no-install-recommends \
      ca-certificates bash \
      libgrpc++1.51t64 libprotobuf32t64 \
    || (apt-get update && DEBIAN_FRONTEND=noninteractive apt-get install -y --no-install-recommends \
      ca-certificates bash libgrpc++1 libprotobuf23) \
 && rm -rf /var/lib/apt/lists/*
COPY --from=build /src/build/compute/gateway_node /opt/openkv/gateway_node
USER nobody
EXPOSE 19000
ENTRYPOINT ["/opt/openkv/gateway_node"]
