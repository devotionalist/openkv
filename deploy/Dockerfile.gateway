# syntax=docker/dockerfile:1
# OpenKV C++ compute gateway（gateway_node）
# 依赖基础镜像 openkv-builder:dev（见 Dockerfile.builder）。
#
#   docker build -f deploy/Dockerfile.builder -t openkv-builder:dev .
#   DOCKER_BUILDKIT=1 docker build -f deploy/Dockerfile.gateway -t openkv-gateway:dev .

ARG BUILDER_IMAGE=openkv-builder:dev
FROM ${BUILDER_IMAGE} AS build
COPY . .
RUN --mount=type=cache,target=/root/.ccache \
    --mount=type=cache,id=openkv-cmake-build,target=/src/build \
    cmake -B build -DOPENKV_BUILD_TESTS=OFF \
 && cmake --build build -j"$(nproc)" --target gateway_node \
 && ccache -s \
 && cp -a build/compute/gateway_node /tmp/

FROM ubuntu:24.04
RUN apt-get update && DEBIAN_FRONTEND=noninteractive apt-get install -y --no-install-recommends \
      ca-certificates bash \
      libgrpc++1.51t64 libprotobuf32t64 \
    || (apt-get update && DEBIAN_FRONTEND=noninteractive apt-get install -y --no-install-recommends \
      ca-certificates bash libgrpc++1 libprotobuf23) \
 && rm -rf /var/lib/apt/lists/*
COPY --from=build /tmp/gateway_node /opt/openkv/gateway_node
USER nobody
EXPOSE 19000
ENTRYPOINT ["/opt/openkv/gateway_node"]
